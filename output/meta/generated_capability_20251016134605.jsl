// Start for FAI10
Column("FAI10") << Set Property(
    "Spec Limits",
    {LSL(17.5), USL(18.5), Target(18)}
);
gb = Process Capability(
    Process Variables( :FAI10 ),
    Moving Range Method( Average of Moving Ranges ),
    Individual Detail Reports( 1 ),
    Capability Box Plots( 0 ),
    Goal Plot( 0 ),
    Capability Index Plot( 0 ),
    Process Performance Plot( 0 )
);
Wait(0.5);
If( Is Scriptable( gb ),
    gb << Set Control Panel( 0 );
    Wait( 0.3 );
    gb << Save Picture( "output/meta/FAI10_spec.png", png );
    gb << Close Window;
);
// End for FAI10


